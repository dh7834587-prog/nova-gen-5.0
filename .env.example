# NOVA GEN 5.0 — runtime configuration
# Copy to .env for local development. Never commit real secrets.

# Port the API + built client are served on.
PORT=3000

# Secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# If unset, a random secret is generated at boot (all sessions end on restart).
SESSION_SECRET=

# Email address that is granted the owner role on registration.
# If unset, the first registered account becomes the owner.
OWNER_EMAIL=

# Google Gemini API key. Server-side only — it is never sent to the browser.
# Without it the assistant and generation modules report "not configured"
# instead of producing placeholder output.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Optional directory for the JSON data snapshot. Leave empty for in-memory
# storage (data is lost on restart).
DATA_DIR=
